# rain-alert の設定。これを .env にコピーして値を入れる（.env は git 管理外）

# Yahoo! デベロッパーネットワークで発行した Client ID（appid）
YAHOO_APPID=

# 通知先 Discord Webhook の URL（まず #sandbox、本番は別チャンネルの URL に差し替え）
DISCORD_WEBHOOK_URL=

# 判定する地点（緯度・経度）と、通知文での呼び名
LAT=
LON=
LOCATION_LABEL=自宅まわり

# --- 以下は任意（空なら既定値）。sandbox で調整する ---
# 降り始め: この強さ[mm/h]以上が START_COUNT 回連続したら
RAIN_START_MMH=1.0
RAIN_START_COUNT=2
# 止み: この強さ[mm/h]未満が STOP_COUNT 回連続したら
RAIN_STOP_MMH=0.5
RAIN_STOP_COUNT=3
# 状態が変わってから逆向きの通知を出さない時間[分]
COOLDOWN_MIN=30
# 1 なら Discord に送らずログに出すだけ（段階1: 観測だけ）
DRY_RUN=1

# --- リビングの電光掲示板（signboard）。SIGNBOARD_API_KEY が空なら連携しない ---
# https://signboard.emaker.dev/admin/ の「APIキー」タブで発行した sb_ で始まるキー
SIGNBOARD_API_KEY=
# この分数以内に降り出す予報なら「もうすぐ降りそう」として表示する
SIGNBOARD_LEAD_MIN=30
# 表示の有効期限 [分]。条件を満たす間は延長し続け、外れたらこの時間で自然に消える
SIGNBOARD_HOLD_MIN=20
